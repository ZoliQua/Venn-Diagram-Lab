{
  "name": "venn-diagram-lab",
  "version": "2.5.0",
  "description": "Headless Venn diagram analysis & rendering for Node — companion to the Venn Diagram Lab web tool.",
  "author": "Zoltán Dul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZoliQua/Venn-Diagram-Lab.git"
  },
  "homepage": "https://venndiagramlab.org/",
  "keywords": [
    "venn",
    "venn-diagram",
    "upset",
    "bioinformatics",
    "set-analysis",
    "svg",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/ZoliQua/Venn-Diagram-Lab/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "vdl": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^12.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@venn-diagram-lab/core": "*",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
